{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/stores/*": ["./src/stores/*"],
      "@/types/*": ["./src/types/*"],
      "@/db/*": ["./src/db/*"],
      "@/schemas/*": ["./src/schemas/*"],
      "@/constants/*": ["./src/constants/*"]
    }
  },
  "include": ["src", "app"],
  "exclude": ["node_modules"]
}